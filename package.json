{
  "name": "mini-crm-bridge",
  "productName": "Mini CRM Bridge",
  "version": "2.0.0",
  "description": "Conecta o WhatsApp deste PC ao Mini CRM",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\"",
    "build:installer": "electron-forge package && electron-builder --windows nsis --publish never",
    "release": "electron-forge package && electron-builder --windows nsis --publish always"
  },
  "build": {
    "appId": "com.minicrm.bridge",
    "productName": "Mini CRM Bridge",
    "directories": {
      "output": "dist"
    },
    "files": [
      ".vite/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true
    },
    "artifactName": "Mini-CRM-Bridge-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "domka4",
        "repo": "mini-crm-bridge"
      }
    ]
  },
  "keywords": [],
  "author": {
    "name": "domka4",
    "email": "donovanfeitosa@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.3",
    "electron": "43.1.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.2",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.24.0",
    "pino": "^9.7.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
